ADMIN_PASSWORD=change-this-before-live
SESSION_SECRET=change-this-to-a-long-random-secret
ADMIN_ALLOWED_IPS=your-public-ip
ADMIN_ALLOWED_IP_HASHES=optional-sha256-ip-hash
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=rzp_test_or_live_key_secret
PAYMENT_CURRENCY=INR
GOOGLE_CLIENT_ID=google-oauth-client-id.apps.googleusercontent.com
OTP_SHOW_DEMO=false
OTP_SENDER_NAME=Dental Factory
OTP_SMS_WEBHOOK_URL=https://your-sms-provider.example/send-otp
OTP_SMS_WEBHOOK_TOKEN=your-sms-provider-token
OTP_EMAIL_WEBHOOK_URL=https://your-email-provider.example/send-otp
OTP_EMAIL_WEBHOOK_TOKEN=your-email-provider-token
OTP_MESSAGE_TEMPLATE={{otp}} is your Dental Factory login OTP. It is valid for {{minutes}} minutes.
NODE_ENV=production
